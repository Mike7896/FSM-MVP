# ---------------------------------------------------------------------------
# Supabase
# Project Settings -> Data API  /  Project Settings -> API Keys
#
# These are the current API keys, which replaced the legacy `anon` and
# `service_role` JWTs. They are opaque strings, not JWTs, and can be rotated
# independently of the project's JWT secret.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Safe to ship to the browser. Subject to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only. Bypasses RLS - never expose to the browser.
SUPABASE_SECRET_KEY="sb_secret_..."

# ---------------------------------------------------------------------------
# Postgres (Drizzle)
# Project Settings -> Database -> Connection string
#
# DATABASE_URL : Transaction pooler (port 6543). Used by the app at runtime.
#                Requires `prepare: false` on postgres.js - already set in
#                lib/db/index.ts.
# DIRECT_URL   : Direct connection (port 5432). Used by drizzle-kit for
#                migrations, which need session-level features the transaction
#                pooler does not support.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the Dashboard endpoint signing secret in prod.
#
# The membership (Billing spec §11): seed a sandbox once with
#   npm run stripe:seed     # products, prices, portal config from lib/membership/catalog.ts
#   npm run stripe:check    # does the account match the spec?
# Locally, `npm run stripe:listen` forwards both webhooks with one secret —
# put the secret it prints in STRIPE_WEBHOOK_SECRET *and*
# STRIPE_CONNECT_WEBHOOK_SECRET.
#
# Platform endpoint events (Dashboard -> Webhooks, "Your account"):
#   product.*, price.*, checkout.session.completed, checkout.session.expired,
#   customer.subscription.*, subscription_schedule.*, invoice.paid,
#   invoice.payment_failed, invoice.payment_action_required
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Set to the deployed public HTTPS URL before emailing account invites.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sentry
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only: uploads source maps. Not needed for local dev.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ===========================================================================
# CONNECTORS
#
# The rule this whole layer follows: **integrate, don't change.** Every
# provider below is one a contractor already has, or can link without changing
# how they get paid. Zelle, Venmo, Cash App, cheques and cash are deliberately
# absent — none of them exposes an API a third party can read a personal
# account through, so money that arrives those ways is either recorded by the
# contractor or matched from the bank feed.
#
# Every variable here is OPTIONAL. A missing key means that connector shows as
# "not ready yet" rather than the server refusing to boot, so local dev and
# preview deploys run with none of them set.
# ===========================================================================

# Encrypts every stored access and refresh token (AES-256-GCM).
# Required before any connector can store credentials. Generate with:
#   openssl rand -base64 32
# Rotating it makes existing connections unreadable — they must be reconnected.
CONNECTION_ENCRYPTION_KEY=""

# Shared secret on /api/cron/sync, sent by Vercel Cron as a bearer token.
# Without it the queue drain refuses to run. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# QuickBooks Online (accounting)
# developer.intuit.com -> My Apps -> Keys & credentials
#
# Redirect URI to register, exactly:
#   http://localhost:3000/api/connections/quickbooks/callback
#   https://<your-domain>/api/connections/quickbooks/callback
# Scope requested: com.intuit.quickbooks.accounting  (payments scope NOT used)
# ---------------------------------------------------------------------------
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
# "sandbox" until Intuit approves the production app. Decides the API host.
QUICKBOOKS_ENVIRONMENT="sandbox"
# Webhooks -> Verifier token. A DIFFERENT secret from the client secret.
QUICKBOOKS_WEBHOOK_VERIFIER=""

# ---------------------------------------------------------------------------
# Plaid (bank feed — read-only)
#
# This is the honest answer for cheques, Zelle, cash deposits and ACH: the
# money shows up as a transaction on the business account and gets matched to
# an open invoice. Plaid cannot move money here — no Transfer product.
# Products to enable: transactions
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENVIRONMENT="sandbox"
PLAID_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Square (card processor — the contractor's own account)
# developer.squareup.com -> Applications -> OAuth
#
# Redirect URI:
#   https://<your-domain>/api/connections/square/callback
# ---------------------------------------------------------------------------
SQUARE_APPLICATION_ID=""
SQUARE_APPLICATION_SECRET=""
SQUARE_ENVIRONMENT="sandbox"
SQUARE_WEBHOOK_SIGNATURE_KEY=""

# ---------------------------------------------------------------------------
# Stripe Connect (the contractor charging a homeowner)
#
# NOT the same Stripe as the billing block above. That one is us charging the
# contractor for their subscription, on our account. This is the contractor
# charging a homeowner, on his. Two integrations, two webhook secrets, one
# secret key.
#
# Accounts are CREATED by this platform, inside its own flow — the contractor
# never visits a Stripe signup page. They are made with STRIPE_SECRET_KEY above
# and driven with a Stripe-Account header, so no extra credential is needed for
# that. Configuration is fixed at creation:
#
#   controller.stripe_dashboard.type = "full"      (immutable, for the life of
#                                                   the account)
#   controller.losses.payments       = "stripe"    (Stripe carries losses)
#   controller.fees.payer            = "account"   (contractor pays Stripe's
#                                                   processing at their rate)
#
# Billing spec §8.1: Stripe's generally available SaaS setup. Express with
# Stripe-held losses is a public preview. Trade-off: no Issuing or Treasury on
# these accounts.
#
# Charges are DIRECT charges on the connected account, which makes the
# contractor the merchant of record: his name on her statement, and disputes
# debited from his balance rather than ours.
#
# Dashboard -> Developers -> Webhooks -> add endpoint, and set "Listen to" to
# "Events on Connected accounts":
#   https://<your-domain>/api/stripe/connect/webhook
# Events: account.updated, charge.succeeded, charge.refunded,
#         charge.dispute.created, charge.dispute.closed, payout.paid,
#         payment_intent.processing, payment_intent.succeeded,
#         payment_intent.payment_failed, payment_intent.canceled
#
# Locally:
#   stripe listen --forward-connect-to localhost:3000/api/stripe/connect/webhook
# ---------------------------------------------------------------------------
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# Only for linking a contractor's EXISTING Stripe account over OAuth, which is
# a separate path from account creation above. Dashboard -> Connect -> Settings.
STRIPE_CONNECT_CLIENT_ID=""

# ---------------------------------------------------------------------------
# PayPal (card processor + Venmo acceptance) — planned, not built
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Gmail (mail) — planned, not built
#
# Restricted scopes need Google's security assessment before production use;
# budget calendar time, not engineering time.
# ---------------------------------------------------------------------------
GOOGLE_MAIL_CLIENT_ID=""
GOOGLE_MAIL_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Resend (email) — quotes, reminders, and a demo sent to yourself
# resend.com -> API Keys
#
# Optional. Without a key, email isn't offered as a way to send a quote, and
# copying the link still works.
#
# EMAIL_FROM is an address on a domain you've verified in Resend. Resend's own
# onboarding@resend.dev works for testing, and only delivers to the email
# address the Resend account was opened with. The business's name is put in
# front of it on each email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Where Help -> "Report a problem / Suggest a feature / Get help" requests are
# emailed. Replying to one replies to the contractor who sent it. Optional:
# without it every request is still saved, and bug reports still reach Sentry.
SUPPORT_EMAIL=""

# Bootstrap owners — comma-separated sign-in email addresses. Opening /admin
# persists their platform admin grant. Owners cannot be demoted in the panel.
# Additional admins are managed in /admin/accounts and stored in platform_admins.
# Removing an owner here does not revoke their persisted grant; also remove
# their admin access in the panel. Ordinary accounts have contractor access.
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Twilio (texts) — notifications to the contractor's own phone
# twilio.com -> Console -> Account Info
#
# Optional. Without these, texts show as "Coming soon" in Settings ->
# Notifications and nothing tries to send one.
#
# TWILIO_FROM is the sending number in +1 format, or a Messaging Service id
# (starts with MG). US numbers must be registered for A2P 10DLC before
# carriers will deliver from them.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Optional admin Costs & Usage integrations (server-only).
# Vercel token needs team billing access; usage includes every project on that team.
VERCEL_USAGE_API_TOKEN=
VERCEL_USAGE_TEAM_ID=
# Resend key with usage read access; send-only keys cannot read usage.
RESEND_USAGE_API_KEY=
