{
  "name": "fsm-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook --forward-connect-to localhost:3000/api/stripe/connect/webhook",
    "stripe:fixtures": "tsx scripts/stripe-fixtures.mts",
    "stripe:seed": "tsx --env-file=.env.local scripts/stripe-seed.mts",
    "stripe:sync": "tsx --env-file=.env.local --conditions=react-server scripts/stripe-sync-catalog.mts",
    "stripe:check": "tsx --env-file=.env.local --conditions=react-server scripts/stripe-check.mts",
    "api:smoke": "node scripts/verify-api.mjs",
    "field:check": "node --experimental-strip-types scripts/field-validation-check.mjs",
    "field:integration-check": "node scripts/field-workflows-check.mjs",
    "tags:check": "tsx --env-file=.env.local --conditions=react-server scripts/tags-check.mts",
    "quote:check": "tsx scripts/tree-check.ts",
    "library:check": "tsx scripts/library-check.ts",
    "plan:check": "tsx scripts/plan-check.ts",
    "quote:persist-check": "tsx --env-file=.env.local --conditions=react-server scripts/persist-check.mts",
    "connector:check": "tsx --env-file=.env.local --conditions=react-server scripts/connector-check.mts",
    "ledger:check": "tsx --env-file=.env.local --conditions=react-server scripts/ledger-check.mts",
    "documents:freeze-sql": "tsx --conditions=react-server scripts/freeze-sql.mts",
    "documents:check": "tsx --env-file=.env.local --conditions=react-server scripts/documents-check.mts",
    "signing:check": "tsx --env-file=.env.local --conditions=react-server scripts/signing-check.mts",
    "signing:quote-check": "tsx --env-file=.env.local --conditions=react-server scripts/quote-signing-check.mts",
    "notifications:check": "tsx --env-file=.env.local --conditions=react-server scripts/notifications-check.mts",
    "notifications:channels-check": "tsx scripts/notification-channels-check.mts",
    "schedule:check": "tsx --env-file=.env.local --conditions=react-server scripts/schedule-check.mts",
    "tasks:check": "tsx --env-file=.env.local --conditions=react-server scripts/tasks-check.mts",
    "support:check": "tsx --env-file=.env.local --conditions=react-server scripts/support-check.mts",
    "admin:check": "tsx --env-file=.env.local --conditions=react-server scripts/admin-check.mts",
    "billing:check": "tsx --env-file=.env.local --conditions=react-server scripts/billing-check.mts",
    "change-orders:check": "tsx --env-file=.env.local --conditions=react-server scripts/change-orders-check.mts",
    "contract-send:check": "tsx --env-file=.env.local --conditions=react-server scripts/contract-send-check.mts",
    "import:check": "tsx --env-file=.env.local --conditions=react-server scripts/import-check.mts",
    "change-orders:http-check": "tsx --env-file=.env.local --conditions=react-server scripts/change-orders-http-check.mts",
    "collection:check": "tsx --env-file=.env.local --conditions=react-server scripts/collection-check.mts",
    "membership:check": "tsx --env-file=.env.local --conditions=react-server scripts/membership-check.mts",
    "membership:scenarios": "tsx --env-file=.env.local --conditions=react-server scripts/membership-scenarios.mts",
    "invite:check": "tsx --env-file=.env.local --conditions=react-server scripts/invite-billing-check.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.75.2",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
